class multi_ue_scenario(gr.top_block):

    def __init__(self):
        gr.top_block.__init__(self, "zmq-proxy", catch_exceptions=True)
        self.flowgraph_started = threading.Event()

        self.zmq_timeout = zmq_timeout = 100
        self.zmq_hwm = zmq_hwm = -1

        self.ue_data = {{ ue_data }}
        self.slow_down_ratio = {{ slow_down_ratio }}
        self.samp_rate = {{ sample_rate }}

        ##################################################
        # Blocks
        ##################################################

        self.zmq_req_sources = {key: zeromq.req_source(gr.sizeof_gr_complex, 1, f'tcp://{el["ip"]:{el["tx_port"]}}',
                                                       zmq_timeout, False, zmq_hwm, False)
                                for key, el in self.ue_data.items()}
        self.zmq_rep_sinks = {key: zeromq.rep_sink(gr.sizeof_gr_complex, 1, f'tcp://0.0.0.0:{el["rx_port"]}',
                                                   zmq_timeout, False, zmq_hwm, True)
                              for key, el in self.ue_data.items()}

        self.blocks_multiply_const_sources = {key: blocks.multiply_const_cc(10 ** (-1.0 * el['path_loss_db'] / 20.0))
                                              for key, el in self.ue_data.items() if key.startswith('ue')
        }

        self.blocks_multiply_const_sinks = {key: blocks.multiply_const_cc(10 ** (-1.0 * el['path_loss_db'] / 20.0))
                                            for key, el in self.ue_data.items() if key.startswith('ue')
                                            }

        self.blocks_throttle = blocks.throttle(gr.sizeof_gr_complex * 1,
                                               (1.0 * self.samp_rate / (1.0 * self.slow_down_ratio)), True)
        self.blocks_add = blocks.add_vcc(1)

        # self.blocks_multiply_const_vxx_0_1_1 = blocks.multiply_const_cc(10 ** (-1.0 * ue2_path_loss_db / 20.0))  # Throttle -> *Multiply* -> Sink UE2
        # self.blocks_multiply_const_vxx_0_0   = blocks.multiply_const_cc(10 ** (-1.0 * ue2_path_loss_db / 20.0))  # Source UE2 -> *Multiply* -> Add
        # self.blocks_multiply_const_vxx_0_1   = blocks.multiply_const_cc(10 ** (-1.0 * ue1_path_loss_db / 20.0))  # Throttle -> *Multiply* -> Sink UE1
        # self.blocks_multiply_const_vxx_0     = blocks.multiply_const_cc(10 ** (-1.0 * ue1_path_loss_db / 20.0))  # Source UE1 -> *Multiply* -> Add
        # self.blocks_add_xx_0 = blocks.add_vcc(1)

        ##################################################
        # Connections
        ##################################################

        # Source gNB -> Throttle
        self.connect((self.zmq_req_sources['gnb'], 0), (self.blocks_throttle, 0))

        for idx, comp in enumerate([k for k in self.ue_data.keys() if k.startswith('ue')]):
            #print(self.blocks_throttle, '->', self.blocks_multiply_const_sinks[comp])
            #print(self.blocks_multiply_const_sinks[comp], '->', self.zmq_rep_sinks[comp])
            # Throttle -> Multiply -> Sink UE
            self.connect((self.blocks_throttle, 0), (self.blocks_multiply_const_sinks[comp], 0))
            self.connect((self.blocks_multiply_const_sinks[comp], 0), (self.zmq_rep_sinks[comp], 0))

            #print(self.zmq_req_sources[comp], '->', self.blocks_multiply_const_sources[comp])
            #print(self.blocks_multiply_const_sources[comp], '->', self.blocks_add, 0)
            # Source UE -> Multiply -> Add
            self.connect((self.zmq_req_sources[comp], 0), (self.blocks_multiply_const_sources[comp], 0))
            self.connect((self.blocks_multiply_const_sources[comp], 0), (self.blocks_add, idx))

        # Add -> Sink gNB
        self.connect((self.blocks_add, 0), (self.zmq_rep_sinks['gnb']))

        # Source gNB -> Throttle
        # self.connect((self.zeromq_req_source_0, 0), (self.blocks_throttle_0, 0))

        # Throttle -> Multiply -> Sink UE
        # self.connect((self.blocks_throttle_0, 0), (self.blocks_multiply_const_vxx_0_1_1, 0))
        # self.connect((self.blocks_multiply_const_vxx_0_1_1, 0), (self.zeromq_rep_sink_0_0, 0))
        # self.connect((self.blocks_throttle_0, 0), (self.blocks_multiply_const_vxx_0_1, 0))
        # self.connect((self.blocks_multiply_const_vxx_0_1, 0), (self.zeromq_rep_sink_0, 0))

        # Source UE -> Multiply -> Add
        # self.connect((self.zeromq_req_source_1_0, 0), (self.blocks_multiply_const_vxx_0_0, 0))
        # self.connect((self.blocks_multiply_const_vxx_0_0, 0), (self.blocks_add_xx_0, 1))
        # self.connect((self.zeromq_req_source_1, 0), (self.blocks_multiply_const_vxx_0, 0))
        # self.connect((self.blocks_multiply_const_vxx_0, 0), (self.blocks_add_xx_0, 0))

        # Add -> Sink gNB
        # self.connect((self.blocks_add_xx_0, 0), (self.zeromq_rep_sink_0_1, 0))


def main(top_block_cls=multi_ue_scenario, options=None):
    tb = top_block_cls()

    def sig_handler(sig=None, frame=None):
        tb.stop()
        tb.wait()

        sys.exit(0)

    signal.signal(signal.SIGINT, sig_handler)
    signal.signal(signal.SIGTERM, sig_handler)

    tb.start()
    tb.flowgraph_started.set()

    try:
        input('Press Enter to quit: ')
    except EOFError:
        pass
    tb.stop()
    tb.wait()


if __name__ == '__main__':
    main()
