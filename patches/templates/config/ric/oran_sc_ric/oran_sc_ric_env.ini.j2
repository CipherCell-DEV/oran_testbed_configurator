# Versions of Docker images as listed in: https://github.com/o-ran-sc/ric-plt-ric-dep/blob/master/RECIPE_EXAMPLE/example_recipe_oran_i_release.yaml
SC_RIC_VERSION={{ near_rt_ric.release }}-release

# Config Parameters
SYSTEM_NAME=oran_sc_ric
RIC_ID=7b0000-000000/18

# RMR MSG Routing Platform
RMR_LOG_VLEVEL=0

# Default IPs and ports
RIC_SUBNET={{ near_rt_ric.ip_config.subnet }}

# E2 Termination point
E2TERM_VER=6.0.4
E2TERM_NAME=e2term
E2TERM_IP= {{ near_rt_ric.ip_config.e2term_ip }}
E2TERM_SCTP_PORT=36421

# E2 Manager
E2MGR_VER=6.0.4
E2MGR_NAME=e2mgr
E2MGR_IP={{ near_rt_ric.ip_config.e2mgr_ip }}

# Database
DBAAS_VER=0.6.4
DBAAS_NAME=dbaas
DBAAS_IP={{ near_rt_ric.ip_config.dbaas_ip }}
DBAAS_PORT=6379
DBAAS_PORT_6379_TCP_ADDR=${DBAAS_IP}
DBAAS_PORT_6379_TCP_PORT=${DBAAS_PORT}
DBAAS_SERVICE_HOST=${DBAAS_IP}
DBAAS_SERCE_PORT=${DBAAS_PORT}

# Subscription Manager
SUBMGR_VER=0.10.1
SUBMGR_NAME=submgr
SUBMGR_IP= {{ near_rt_ric.ip_config.submgr_ip }}

# xApps Manager
APPMGR_VER=0.5.7
APPMGR_NAME=appmgr
APPMGR_IP={{ near_rt_ric.ip_config.appmgr_ip }}

# Routing Manager Simulator
# version is git branch name
RTMGR_SIM_VER=${SC_RIC_VERSION}
RTMGR_SIM_NAME=rtmgr
RTMGR_SIM_IP={{ near_rt_ric.ip_config.rtmgr_sim_ip }}
RTMGR_SIM_PORT=12020

# xApp Python Framework
# version is git branch name
XAPP_PY_FRAME_VER=${SC_RIC_VERSION}
XAPP_PY_RUNNER_IP={{ near_rt_ric.ip_config.xapp_runner_ip }}
