## Telegraf

TELEGRAF_VERSION=1.35.0
TELEGRAF_LISTENER_PORT=4000
TELEGRAF_INPUT_INTERVAL=1s
TELEGRAF_OUTPUT_INTERVAL=1s
TELEGRAF_BUFFER_LIMIT=10000
# TELEGRAF_QUIET=false
# TELEGRAF_DEBUG=true
# TELEGRAF_LOG_FILE=/var/log/telegraf.log
# TELEGRAF_DUMP_FILE=/var/log/telegraf/metrics.txt
# TELEGRAF_LOAD_FILE=/etc/telegraf/metrics.txt
# TELEGRAF_CLI_EXTRA_ARGS=--config /etc/telegraf/dump_metrics.conf
#   --config /etc/telegraf/load_metrics.conf

## InfluxDB

INFLUXDB3_VERSION=3.1.0-core

INFLUXDB3_PORT=8081
INFLUXDB3_HTTP_BIND_ADDR=0.0.0.0:$INFLUXDB3_PORT
INFLUXDB3_HOST_URL=http://127.0.0.1:$INFLUXDB3_PORT
INFLUXDB3_EXTERNAL_URL=http://influxdb:${INFLUXDB3_PORT}
INFLUXDB3_AUTH_TOKEN=fake-token-1234567890abcdef
INFLUXDB3_BUCKET=srsran
INFLUXDB3_TESTBED=default
INFLUXDB3_LOG_LEVEL=error
INFLUXDB3_RATE_LIMIT=0
INFLUXDB3_RATE_LIMIT_PERIOD=0s

INFLUXDB3_AUTH_TOKEN_FILE=/run/secrets/token

## Grafana

GF_VERSION=12.0.2
GF_PORT=3000
GF_LOGO_URL=https://raw.githubusercontent.com/srsran/srsRAN_Project_docs/main/docs/source/.imgs/logo.png

GF_AUTH_ANONYMOUS_ENABLED=true
GF_LOG_LEVEL=warning

GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/etc/dashboards/home.json
GF_DASHBOARDS_MIN_REFRESH_INTERVAL=1s
GF_PLUGINS_PLUGIN_ADMIN_ENABLED=false

MONGODB_IP=127.0.0.1
OPEN5GS_IP=10.53.1.2
UE_IP_BASE=10.45.0
UPF_ADVERTISE_IP=10.53.1.2
DEBUG=false
SUBSCRIBER_DB=001010123456780,00112233445566778899aabbccddeeff,opc,63bfa50ee6523365ff14c1f45f88737d,8000,9,10.45.1.2
NETWORK_NAME_FULL=srsRAN
NETWORK_NAME_SHORT=srsRAN

# Timezone - this setting will also be conveyed by Open5GS towards UE via "configuration update command"; comment for UTC
TZ=Europe/Madrid

# Versions of Docker images as listed in: https://github.com/o-ran-sc/ric-plt-ric-dep/blob/master/RECIPE_EXAMPLE/example_recipe_oran_i_release.yaml
SC_RIC_VERSION=i-release

# Config Parameters
SYSTEM_NAME=oran_sc_ric
RIC_ID=7b0000-000000/18

# RMR MSG Routing Platform
RMR_LOG_VLEVEL=0

# Default IPs and ports
RIC_SUBNET=10.0.2.0/24

# E2 Termination point
E2TERM_VER=6.0.4
E2TERM_NAME=e2term
E2TERM_IP=10.0.2.10
E2TERM_SCTP_PORT=36421

# E2 Manager
E2MGR_VER=6.0.4
E2MGR_NAME=e2mgr
E2MGR_IP=10.0.2.11

# Database
DBAAS_VER=0.6.4
DBAAS_NAME=dbaas
DBAAS_IP=10.0.2.12
DBAAS_PORT=6379
DBAAS_PORT_6379_TCP_ADDR=${DBAAS_IP}
DBAAS_PORT_6379_TCP_PORT=${DBAAS_PORT}
DBAAS_SERVICE_HOST=${DBAAS_IP}
DBAAS_SERCE_PORT=${DBAAS_PORT}

# Subscription Manager
SUBMGR_VER=0.10.1
SUBMGR_NAME=submgr
SUBMGR_IP=10.0.2.13

# xApps Manager
APPMGR_VER=0.5.7
APPMGR_NAME=appmgr
APPMGR_IP=10.0.2.14

# Routing Manager Simulator
# version is git branch name
RTMGR_SIM_VER=${SC_RIC_VERSION}
RTMGR_SIM_NAME=rtmgr
RTMGR_SIM_IP=10.0.2.15
RTMGR_SIM_PORT=12020

# xApp Python Framework
# version is git branch name
XAPP_PY_FRAME_VER=${SC_RIC_VERSION}
XAPP_PY_RUNNER_IP=10.0.2.20
